FROM python:3.11-slim

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl && rm -rf /var/lib/apt/lists/*

COPY requirements.posbridge.txt /app/requirements.posbridge.txt
RUN pip install --no-cache-dir -r /app/requirements.posbridge.txt

COPY posbridge /app/posbridge
EXPOSE 8090
CMD ["bash","-lc","uvicorn posbridge.main:app --host ${POSBRIDGE_HOST:-0.0.0.0} --port ${POSBRIDGE_PORT:-8090}"]
