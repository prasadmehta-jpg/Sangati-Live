# Core
SANGATI_ENV=dev
SANGATI_SECRET=change-me-long-random
SANGATI_TZ=Pacific/Auckland

# API
API_HOST=0.0.0.0
API_PORT=8080

# Data
DATABASE_URL=postgresql+psycopg://sangati:sangati@db:5432/sangati
REDIS_URL=redis://redis:6379/0

# Vector DB (Qdrant)
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=sangati_knowledge

# LLM (choose one)
# If you have OpenAI-compatible endpoint:
LLM_PROVIDER=openai_compat
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Offline/local-only mode (no external LLM):
# LLM_PROVIDER=none

# POS Bridge
POSBRIDGE_BASE_URL=http://posbridge:8090
POSBRIDGE_TOKEN=posbridge-token-change-me

# Policy
POLICY_FILE=/app/policy/policy.yaml
