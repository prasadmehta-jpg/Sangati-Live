# Sangati Configuration
# Copy this file to .env and adjust as needed

# Application
APP_NAME=Intuiserve Sangati
APP_VERSION=2.0.0
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000

# Database (SQLite - offline first)
DATABASE_URL=sqlite+aiosqlite:///./sangati.db
DATABASE_PATH=./sangati.db

# Decision Engine confidence threshold (0.0 to 1.0)
DECISION_CONFIDENCE_THRESHOLD=0.6

# Nudge TTL (seconds before auto-expire)
NUDGE_TTL_SECONDS=300

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# Data directory
DATA_DIR=./data
